# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# PyInstaller build outputs
build/
dist/
*.manifest
*.exe

# Local settings, logs and caches
settings.json
*.log
*.tmp
*.bak
.flock_*
*.locked
scratch*

# IDE and Editor configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Local release packages and validation logs can contain machine-specific data.
*.zip
SHA256SUMS*.txt
build_verification*.txt
gui_validation_report.txt
relock_scenarios_report.txt
test_*.txt
codex-clipboard-*.png

# Local credentials must never be packaged with the source.
.env
.env.*
secrets/
credentials*.json
